APP_NAME="Rute & Jadwal Service"
APP_ENV=local
APP_KEY=base64:SyhaaNNuJ47KsQ9HXvjwo1mBDKVGhJYfJL88IhDs8Nw=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database: SQLite (file-based). Tidak ada container DB terpisah sehingga
# service selalu bisa start tanpa healthcheck/startup MySQL.
DB_CONNECTION=sqlite

# Driver berbasis file/sync agar tidak butuh tabel sessions/queue tambahan.
SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Swagger/OpenAPI selalu di-generate ulang agar mencerminkan endpoint REST.
L5_SWAGGER_GENERATE_ALWAYS=true
LIGHTHOUSE_QUERY_CACHE_ENABLE=false

MAIL_MAILER=log

# Integrasi pusat IAE (Tugas 3) — dimatikan saat penilaian Tugas 2 agar
# endpoint POST tidak menunggu/menggantung pada layanan eksternal.
IAE_INTEGRATIONS_ENABLED=false
IAE_SSO_URL=https://iae-sso.virtualfri.id
IAE_API_KEY=KEY-MHS-94
IAE_TEAM_ID=TEAM-12
IAE_NIM=102022430022

VITE_APP_NAME="${APP_NAME}"
