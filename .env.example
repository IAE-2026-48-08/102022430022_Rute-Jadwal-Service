APP_NAME="Rute & Jadwal Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Native (Laragon): DB_HOST=127.0.0.1
# Docker: nilai DB_* di-override oleh docker-compose.yaml (DB_HOST=db)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=102022430022_rute_jadwal_service
DB_USERNAME=root
DB_PASSWORD=rootpassword

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
LIGHTHOUSE_QUERY_CACHE_ENABLE=false

MAIL_MAILER=log

# Integrasi pusat IAE (Tugas 3)
IAE_SSO_URL=https://iae-sso.virtualfri.id
IAE_API_KEY=
IAE_TEAM_ID=TEAM-12
IAE_NIM=102022430022

VITE_APP_NAME="${APP_NAME}"
